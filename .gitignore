# Credentials and private local configuration.
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.dump
*.keystore
*.kdbx
*.log
*.bak
*.backup
*.bundle
*.sqlite
*.sqlite3
*.db
*.sql
**/.git-credentials
**/.npmrc
**/.pypirc
**/id_rsa*
**/id_ed25519*
**/credentials
/.ssh/
/.aws/
/.config/
/secrets/
/private/
/backups/

# Production host configuration remains local; use the portable example.
/compose.yaml
/compose.*.yaml
!/compose.example.yaml
/docker-compose.yml
/docker-compose.override.*
/deployment/*
!/deployment/build-experience.py
!/deployment/palette.py
!/deployment/icons.py
!/deployment/workbench.py
/public/YUKLEME.txt*

# Local archives, build previews, editor state and caches.
/*.zip
/*.tar
/*.tar.gz
/*.tgz
**/node_modules/
**/__pycache__/
*.pyc
.cache/
.DS_Store
.idea/
.vscode/
